modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss", "atk", "at-spi2-atk", "cairo", "cups", "dbus", "expat", "fontconfig", "freetype", "gdk-pixbuf", "gtk3", "libdrm", "libxkbcommon", "mesa", "pango", "alsa-lib", "xorg.libX11", "xorg.libxcb", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXi", "xorg.libXrandr", "xorg.libXrender", "xorg.libXtst", "xorg.libxshmfence", "libgbm"]

[objectStorage]
defaultBucketID = "replit-objstore-840d852c-4e14-4418-af4e-41ecb4434056"

[userenv]

[userenv.development]
BRANDMYITEM_PUBLIC_ORIGINS = "https://3f7c2cc8-f08b-4158-944b-09fd3b52c7cc-00-32gdmyf8sb6bx.riker.replit.dev"
BRANDMYITEM_PUBLIC_URL = "https://3f7c2cc8-f08b-4158-944b-09fd3b52c7cc-00-32gdmyf8sb6bx.riker.replit.dev"
